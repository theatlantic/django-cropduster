{
  "_meta": {
    "description": "A standalone client's crop: a hand-built crop POST that never went through the dialog. No thumbs-0-id is sent even though INITIAL_FORMS=1, so ThumbFormSet._construct_form rewrites the pk to None and the view's 'standalone and not cropped_thumbs' fallback re-saves the initial form. Downstream clients read data.thumbs[0].id from this response.",
    "normalize": {
      "applies_to": "raw response body text, before json.loads",
      "function": "tests.data.legacy_wire.record.normalize",
      "not_normalized": [
        "md5 digests (inputs are fixed files; digests are reproducible)",
        "database primary keys (each scenario runs against a flushed database with reset sequences)"
      ],
      "rules": [
        {
          "name": "DATE",
          "pattern": "(?<=/)(?:19|20)\\d{2}/\\d{2}(?=/)",
          "replacement": "{Y}/{m}",
          "why": "upload_to values contain strftime codes (%Y/%m); the expanded year/month depends on the recording date."
        },
        {
          "name": "DIR",
          "pattern": "(?<=/)[^/\"\\\\]+(?=/[A-Za-z0-9_@.\\-]+\\.(?:jpe?g|png|gif|tiff?|webp)\\b)",
          "replacement": "{DIR}",
          "why": "get_upload_foldername() appends a -N suffix when a directory of that name already exists, so the slug depends on storage state."
        },
        {
          "name": "MTIME",
          "pattern": "(?<=[?&])(?:_|t|v|ts|mtime)=\\d{9,}",
          "replacement": "{MTIME}",
          "why": "mtime-based cache-busting query params on generated media URLs."
        },
        {
          "name": "ERROR_ID",
          "pattern": " id=\\\\?\"id_[^\"\\\\]*_error\\\\?\"",
          "replacement": "",
          "why": "Django 5.2 added ErrorList(field_id=...), which renders id=\"id_<auto_id>_error\" on the <ul class=\"errorlist\"> of a field error; earlier versions render no id at all."
        }
      ]
    },
    "request": {
      "files": {},
      "method": "POST",
      "path": "/cropduster/crop/",
      "post": {
        "crop-image_id": "1",
        "crop-orig_h": "800",
        "crop-orig_image": "img/posts/{Y}/{m}/{DIR}/original.jpg",
        "crop-orig_w": "674",
        "crop-sizes": "[{\"name\":\"crop\",\"w\":null,\"h\":null,\"min_w\":1,\"min_h\":1,\"max_w\":null,\"max_h\":null,\"retina\":0,\"label\":\"Crop\",\"required\":true,\"__type__\":\"Size\"}]",
        "crop-standalone": "on",
        "thumbs-0-crop_h": "800",
        "thumbs-0-crop_w": "674",
        "thumbs-0-crop_x": "0",
        "thumbs-0-crop_y": "0",
        "thumbs-0-name": "crop",
        "thumbs-0-size": "{\"name\":\"crop\",\"w\":null,\"h\":null,\"min_w\":1,\"min_h\":1,\"max_w\":null,\"max_h\":null,\"retina\":0,\"label\":\"Crop\",\"required\":true,\"__type__\":\"Size\"}",
        "thumbs-INITIAL_FORMS": "1",
        "thumbs-MAX_NUM_FORMS": "1000",
        "thumbs-MIN_NUM_FORMS": "0",
        "thumbs-TOTAL_FORMS": "1"
      }
    },
    "response": {
      "content_type": "application/json",
      "status_code": 200
    },
    "scenario": "standalone_crop",
    "setup": "Field-for-field replay of a downstream rich-text editor's standalone crop POST, preceded by standalone_upload.",
    "source": {
