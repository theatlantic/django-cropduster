{
  "_meta": {
    "description": "Second-size navigation against an Article that already has saved thumbs. thumbs-0 (main) has changed crop coordinates; thumbs-1 (no_height) keeps its stored crop and only its 'changed' checkbox differs, so the view takes the elif branch and copies no_height.jpg to no_height_tmp.jpg instead of regenerating it.",
    "normalize": {
      "applies_to": "raw response body text, before json.loads",
      "function": "tests.data.legacy_wire.record.normalize",
      "not_normalized": [
        "md5 digests (inputs are fixed files; digests are reproducible)",
        "database primary keys (each scenario runs against a flushed database with reset sequences)"
      ],
      "rules": [
        {
          "name": "DATE",
          "pattern": "(?<=/)(?:19|20)\\d{2}/\\d{2}(?=/)",
          "replacement": "{Y}/{m}",
          "why": "upload_to values contain strftime codes (%Y/%m); the expanded year/month depends on the recording date."
        },
        {
          "name": "DIR",
          "pattern": "(?<=/)[^/\"\\\\]+(?=/[A-Za-z0-9_@.\\-]+\\.(?:jpe?g|png|gif|tiff?|webp)\\b)",
          "replacement": "{DIR}",
          "why": "get_upload_foldername() appends a -N suffix when a directory of that name already exists, so the slug depends on storage state."
        },
        {
          "name": "MTIME",
          "pattern": "(?<=[?&])(?:_|t|v|ts|mtime)=\\d{9,}",
          "replacement": "{MTIME}",
          "why": "mtime-based cache-busting query params on generated media URLs."
        },
        {
          "name": "ERROR_ID",
          "pattern": " id=\\\\?\"id_[^\"\\\\]*_error\\\\?\"",
          "replacement": "",
          "why": "Django 5.2 added ErrorList(field_id=...), which renders id=\"id_<auto_id>_error\" on the <ul class=\"errorlist\"> of a field error; earlier versions render no id at all."
        }
      ]
    },
